<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.cloudvane.litefactory</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/litefactory</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LF_HOME</key>
		<string>/Users/mario/.litefactory</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/</string>
	<key>StandardOutPath</key>
	<string>/Users/mario/.litefactory/logs/launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mario/.litefactory/logs/launchd.err.log</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>ExitTimeOut</key>
	<integer>20</integer>
</dict>
</plist>
