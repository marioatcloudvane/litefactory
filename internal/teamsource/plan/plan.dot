// Owner gates authenticate replies; agent completion never grants approval.
digraph plan {
 graph [team="builtin", mode="plan", profile_version="1", start="stories"];
 stories [lf_action="lf_plan_agent", lf_stage="stories", lf_agent_markdown="stories", lf_skills="plan-evidence", lf_outcomes="success,failed", lf_limit="8"];
 stories_review [lf_action="lf_plan_review", lf_stage="stories", lf_outcomes="approved,stories,waiting", lf_limit="8"];
 engineering [lf_action="lf_plan_agent", lf_stage="engineering", lf_agent_markdown="engineering", lf_skills="plan-evidence", lf_outcomes="success,failed", lf_limit="8"];
 engineering_review [lf_action="lf_plan_review", lf_stage="engineering", lf_outcomes="approved,stories,engineering,waiting", lf_limit="8"];
 acceptance [lf_action="lf_plan_agent", lf_stage="acceptance", lf_agent_markdown="acceptance", lf_skills="plan-evidence", lf_outcomes="success,failed", lf_limit="8"];
 acceptance_review [lf_action="lf_plan_review", lf_stage="acceptance", lf_outcomes="approved,stories,engineering,acceptance,waiting", lf_limit="8"];
 consistency [lf_action="lf_plan_consistency", lf_outcomes="valid,stories,engineering,acceptance,failed", lf_limit="8"];
 publication [lf_action="lf_plan_publish", lf_outcomes="confirmed,pending,failed", lf_limit="8"];
 final_review [lf_action="lf_plan_review", lf_stage="final", lf_outcomes="approved,stories,engineering,acceptance,waiting", lf_limit="8"];
 save [lf_action="lf_plan_save", lf_outcomes="saved,failed", lf_limit="8"];
 waiting [lf_terminal="true"];
 stopped [lf_terminal="true"];
 complete [lf_terminal="true"];
 stories -> stories_review [lf_on="success"];
 stories -> stopped [lf_on="failed"];
 engineering -> engineering_review [lf_on="success"];
 engineering -> stopped [lf_on="failed"];
 acceptance -> acceptance_review [lf_on="success"];
 acceptance -> stopped [lf_on="failed"];
 stories_review -> engineering [lf_on="approved"];
 stories_review -> waiting [lf_on="waiting"];
 stories_review -> stories [lf_on="stories"];
 engineering_review -> acceptance [lf_on="approved"];
 engineering_review -> waiting [lf_on="waiting"];
 engineering_review -> stories [lf_on="stories"];
 engineering_review -> engineering [lf_on="engineering"];
 acceptance_review -> consistency [lf_on="approved"];
 acceptance_review -> waiting [lf_on="waiting"];
 acceptance_review -> stories [lf_on="stories"];
 acceptance_review -> engineering [lf_on="engineering"];
 acceptance_review -> acceptance [lf_on="acceptance"];
 final_review -> save [lf_on="approved"];
 final_review -> waiting [lf_on="waiting"];
 final_review -> stories [lf_on="stories"];
 final_review -> engineering [lf_on="engineering"];
 final_review -> acceptance [lf_on="acceptance"];
 consistency -> stories [lf_on="stories"];
 consistency -> engineering [lf_on="engineering"];
 consistency -> acceptance [lf_on="acceptance"];
 consistency -> publication [lf_on="valid"];
 consistency -> stopped [lf_on="failed"];
 publication -> final_review [lf_on="confirmed"];
 publication -> waiting [lf_on="pending"];
 publication -> stopped [lf_on="failed"];
 save -> complete [lf_on="saved"];
 save -> stopped [lf_on="failed"];
}
