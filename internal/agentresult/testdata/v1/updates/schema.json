{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litefactory:agent-result-update:1",
  "title": "Agent result sparse update application schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "operations"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "target"
        ],
        "properties": {
          "op": {
            "enum": [
              "set",
              "remove",
              "add_item",
              "update_item",
              "remove_item",
              "reorder"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "enum": [
                  "outcome",
                  "comment",
                  "reason",
                  "recommendation",
                  "questions",
                  "artifacts",
                  "payload.research.request",
                  "payload.research.findings",
                  "payload.research.decisions",
                  "payload.research.assumptions",
                  "payload.plan.summary",
                  "payload.plan.context",
                  "payload.plan.stories",
                  "payload.plan.stories.title",
                  "payload.plan.stories.intent",
                  "payload.plan.stories.user_story",
                  "payload.plan.stories.acceptance_criteria",
                  "payload.plan.stories.tasks",
                  "payload.plan.stories.architecture",
                  "payload.plan.stories.dependencies",
                  "payload.plan.storyrequest",
                  "payload.plan.storyset",
                  "payload.implement.stories",
                  "payload.implement.aggregate_checks",
                  "payload.validate.stories",
                  "payload.spike.request",
                  "payload.spike.work_done",
                  "payload.spike.findings",
                  "payload.spike.decisions",
                  "payload.spike.not_done"
                ]
              },
              "story": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "value": {
            "not": {
              "type": "null"
            }
          },
          "order": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "enum": [
                    "set",
                    "add_item",
                    "update_item"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "value"
              ],
              "not": {
                "required": [
                  "order"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "enum": [
                    "remove",
                    "remove_item"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "value"
                    ]
                  },
                  {
                    "required": [
                      "order"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "reorder"
                }
              }
            },
            "then": {
              "required": [
                "order"
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
