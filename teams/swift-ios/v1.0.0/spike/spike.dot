// Spike is one conversational agent. It reads the code, answers questions, asks
// when something is unclear, changes code only when the owner clearly says so,
// runs whatever checks it judges useful, and reports. All of that lives in the
// role's Markdown. The factory does as little as possible.
//
// The agent's result names its own response (lf_response="result"): "ask" or
// "done". The factory follows that response straight to a publication: a
// question is posted and the instance waits for the owner, whose reply resumes
// this same agent with its saved result as context; a finished report is posted
// and the Spike completes. A later owner reply starts the next Spike from this
// one. A failed attempt posts why and stops.
//
// The two publication nodes are the factory's own posting steps. They hold no
// Spike logic: they post the agent's message as written and, for a question,
// record the durable owner wait.
digraph spike {
 graph [team="swift-ios", mode="spike", profile_version="2", start="spike"];

 spike    [lf_action="lf_agent", lf_agent_markdown="spike", lf_skills="spike-result", lf_access="write", lf_response="result", lf_outcomes="ask,done,failed", lf_limit="8"];
 ask      [lf_action="lf_ask", lf_kind="question", lf_outcomes="published", lf_source="spike", lf_limit="8"];
 report   [lf_action="lf_comment", lf_kind="final", lf_outcomes="published", lf_source="spike", lf_limit="8"];
 failure  [lf_action="lf_comment", lf_kind="failure", lf_outcomes="published", lf_limit="8"];
 waiting  [lf_terminal="true"];
 complete [lf_terminal="true"];
 stopped  [lf_terminal="true"];

 spike   -> ask      [lf_on="ask"];
 spike   -> report   [lf_on="done"];
 spike   -> failure  [lf_on="failed"];
 ask     -> waiting  [lf_on="published"];
 report  -> complete [lf_on="published"];
 failure -> stopped  [lf_on="published"];
}
