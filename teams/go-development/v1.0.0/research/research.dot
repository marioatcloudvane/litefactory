// Research runs in two owner-authorized stages, each with one reasoning role.
//
// Clarification is an introduction: one pass, publish, hand on. Shaping is
// where the work happens, so it cannot advance on its own — the only edge into
// its final publication needs "approved", which the factory follows when an authenticated
// owner replies done to the current review, without another agent invocation. Everything else loops back for another pass.
//
// One run advances one stage. Publishing the report parks the instance, and a
// graph dispatch carries it into the run that continues it. Limits persist
// across replies, and every loop, branch and comment names the agent whose
// response it reads, so a later stage bootstraps from its own default instead
// of inheriting the previous one's. The ask default initializes only the first
// evaluation of each stage.
//
// Before a shaped draft goes to the owner for review, a builder check judges
// the saved result and publishes its advice as a short comment just above the
// draft it checked (lf_format="brief": AI;DR and one line per point). It is
// advisory: it cannot decide, ask or approve, and success and failure both
// continue to the same review. Shaping folds its points into the next pass.
digraph research {
 graph [team="go-development", mode="research", profile_version="1", start="loop"];

 // ---- Stage 1: clarification -------------------------------------------
 loop        [lf_action="lf_loop",    lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_default="ask", lf_limit="8", lf_source="investigate"];
 continuing [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="continue", lf_limit="8", lf_source="investigate"];
 brief [lf_action="lf_research_brief", lf_outcomes="success,failed", lf_source="investigate", lf_limit="8"];
 investigate [lf_action="lf_agent",   lf_outcomes="success,failed", lf_agent_markdown="research", lf_skills="research-evidence,research-mode-feature,research-mode-change,research-mode-bug,research-mode-refactor,research-mode-integration,research-mode-operations,research-mode-agent-guidance", lf_limit="8"];
 question    [lf_action="lf_if",      lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_limit="8", lf_source="investigate"];
 ask         [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_limit="8", lf_source="investigate"];
 report      [lf_action="lf_comment", lf_outcomes="published", lf_kind="final",    lf_limit="1", lf_source="investigate"];

 // ---- Stage 2: shaping ---------------------------------------------------
 shapeloop   [lf_action="lf_loop",    lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_default="ask", lf_limit="8", lf_source="shape"];
 shapecontinue [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="continue", lf_limit="8", lf_source="shape"];
 shapebrief [lf_action="lf_research_brief", lf_outcomes="success,failed", lf_source="shape", lf_limit="8"];
 shape       [lf_action="lf_agent",   lf_outcomes="success,failed", lf_agent_markdown="shaping", lf_skills="research-evidence,research-mode-feature,research-mode-change,research-mode-bug,research-mode-refactor,research-mode-integration,research-mode-operations,research-mode-agent-guidance", lf_limit="8"];
 settled     [lf_action="lf_if",      lf_outcomes="true,false", lf_field="response", lf_condition="approved", lf_limit="8", lf_source="shape"];
 shaped      [lf_action="lf_if",      lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_limit="8", lf_source="shape"];
 clarify     [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_limit="8", lf_source="shape"];
 review      [lf_action="lf_ask", lf_outcomes="published", lf_kind="review",   lf_limit="8", lf_source="shape"];
 agreed      [lf_action="lf_comment", lf_outcomes="published", lf_kind="final",    lf_limit="1", lf_source="shape"];
 buildcheck  [lf_action="lf_judge", lf_outcomes="success,failed", lf_source="shape", lf_agent="codex", lf_limit="8", lf_focus="Builder check of the shaping draft the owner sees right after this comment. Read only the pinned saved shaping result (the source of its brief), not the discussion. You will plan from this alone. Raise only points whose answer would change what gets built. Check that every O- outcome is clear and testable, that N-/K- boundaries are explicit, that the impact analysis names what is touched, who depends on it and what must be retired or migrated, and that S-01 mode and size fit the request. Start each finding title with who settles it: 'Owner's:' (only the owner can decide what gets built; ask it as a plain question), 'Agent's call:' (Shaping may decide; the correction says what to assume) or 'Already answered:' (the brief should say it more clearly). Owner's points first. Summary: start with 'AI;DR:' and say in one or two plain sentences whether the draft is buildable and how many points need the owner (say none when none), and that Shaping folds the rest into its next pass. Owner language only: no factory terms such as captures, nodes, validation or saved results. One short sentence each for concern, impact and correction. Advisory only."];
 buildadvice [lf_action="lf_comment", lf_outcomes="published", lf_kind="advisory", lf_format="brief", lf_limit="8", lf_source="buildcheck"];

 // ---- Failure and terminals ----------------------------------------------
 failed      [lf_action="lf_comment", lf_outcomes="published", lf_kind="failure",  lf_limit="1"];
 waiting     [lf_terminal="true"];
 complete    [lf_terminal="true"];
 stopped     [lf_terminal="true"];

 // Stage 1: investigate until the request is clear, then report and hand on.
 loop        -> investigate [lf_on="true"];
 loop        -> report      [lf_on="false"];
 investigate -> brief       [lf_on="success"];
 brief -> continuing [lf_on="success"];
 continuing -> investigate [lf_on="true"];
 continuing -> question [lf_on="false"];
 brief -> stopped [lf_on="failed"];
 question    -> ask         [lf_on="true"];    // needs an answer
 question    -> loop        [lf_on="false"];   // nothing to ask; report
 ask         -> waiting     [lf_on="published"];
 report      -> shapeloop   [lf_on="published"];  // hands over; does not end

 // Stage 2: shape, show the owner, and advance only once they approve.
 shapeloop   -> shape       [lf_on="true"];
 shapeloop   -> agreed      [lf_on="false"];
 shape       -> shapebrief  [lf_on="success"];
 shapebrief -> shapecontinue [lf_on="success"];
 shapecontinue -> shape [lf_on="true"];
 shapecontinue -> settled [lf_on="false"];
 shapebrief -> stopped [lf_on="failed"];
 settled     -> agreed      [lf_on="true"];    // the owner approved
 settled     -> shaped      [lf_on="false"];
 shaped      -> clarify     [lf_on="true"];    // needs an answer
 shaped      -> buildcheck  [lf_on="false"];   // has a draft; builder check first
 buildcheck  -> buildadvice [lf_on="success"];
 buildcheck  -> buildadvice [lf_on="failed"];  // advisory: a failed check is published, not fatal
 buildadvice -> review      [lf_on="published"]; // then asks if it stands
 clarify     -> waiting     [lf_on="published"];
 review      -> waiting     [lf_on="published"];
 agreed      -> complete    [lf_on="published"];

 // A failed stage reports why and stops; nothing retries on its own.
 investigate -> failed      [lf_on="failed"];
 shape       -> failed      [lf_on="failed"];
 failed      -> stopped     [lf_on="published"];
}
