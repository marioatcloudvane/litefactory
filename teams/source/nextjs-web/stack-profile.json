{
  "version": 1,
  "guidance": [
    {"id": "owner-report", "skill": "plan/skills/owner-report/SKILL.md"},
    {"id": "nextjs-web", "skill": "plan/skills/plan-nextjs-web-guidance/SKILL.md"},
    {"id": "agent-setup", "skill": "plan/skills/plan-agent-setup-guidance/SKILL.md"}
  ],
  "requirements": {
    "os": ["darwin", "linux"],
    "arch": ["arm64", "amd64"],
    "executables": ["node", "npm"]
  },
  "setup": [
    {"name": "install", "argv": ["npm", "ci"], "cwd": ".", "timeout_seconds": 900}
  ],
  "checks": [
    {"name": "lint", "argv": ["npm", "run", "lint"], "cwd": ".", "timeout_seconds": 600},
    {"name": "build", "argv": ["npm", "run", "build"], "cwd": ".", "timeout_seconds": 900}
  ],
  "environment": [{"name": "CI", "value": "1"}],
  "override_fields": ["checks", "setup", "environment"],
  "required_fields": ["checks", "setup"]
}
