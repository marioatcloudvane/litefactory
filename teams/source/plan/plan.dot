// Factory policy supplies stage selection and approval as closed response values from retained authenticated state.
// Review-ready is never approval. Each wait is durable; exhaustion is resumable stopped.
// Every failing outcome of a story effect (conflict, uncertain, failed) reaches the one failure comment, so the owner is always told the cause and how to retry.
// The set stage comes first: it proposes the story set and waits on the parent for the owner to promote it. A session that already has stories skips it, because the stage decision is false.
// After promotion the story stage is a bounded creation cycle: story_pick freshly selects the next promoted story that has no draft, story_agent drafts it, and its review is published before the next pick. A pick that finds none ends the cycle at the durable owner waits.
// The cycle nodes carry lf_limit="13": twelve stories in a set plus one owner-requested revision pass.
digraph plan {
 graph [team="builtin", mode="plan", profile_version="1", start="select_set"];
 select_set [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="set", lf_limit="24"];
 select_set -> set_loop [lf_on="true"];
 select_set -> select_story [lf_on="false"];
 select_story [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="story", lf_limit="24"];
 select_technical [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="technical", lf_limit="24"];
 select_story -> story_loop [lf_on="true"];
 select_story -> select_technical [lf_on="false"];
 select_technical -> technical_loop [lf_on="true"];
 select_technical -> select_acceptance [lf_on="false"];
 select_acceptance [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="acceptance", lf_limit="24"];
 select_acceptance -> acceptance_loop [lf_on="true"];
 select_acceptance -> stopped [lf_on="false"];
 set_loop [lf_action="lf_loop", lf_outcomes="true,false", lf_field="response", lf_condition="set", lf_limit="8"];
 set_agent [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="plan-set", lf_skills="plan-story-set", lf_limit="8"];
 set_question [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_source="set_agent", lf_limit="8"];
 set_draft [lf_action="lf_plan_story", lf_source="set_agent", lf_outcomes="applied,conflict,failed,uncertain", lf_limit="8"];
 set_gate [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="approved", lf_limit="8"];
 set_ask [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_source="set_agent", lf_limit="8"];
 set_review [lf_action="lf_ask", lf_outcomes="published", lf_kind="review", lf_source="set_agent", lf_limit="8"];
 set_loop -> set_agent [lf_on="true"];
 set_loop -> stopped [lf_on="false"];
 set_agent -> set_question [lf_on="success"];
 set_agent -> failed [lf_on="failed"];
 set_question -> set_ask [lf_on="true"];
 set_question -> set_draft [lf_on="false"];
 set_draft -> set_gate [lf_on="applied"];
 set_draft -> failed [lf_on="conflict"];
 set_draft -> failed [lf_on="failed"];
 set_draft -> failed [lf_on="uncertain"];
 set_gate -> promoted [lf_on="true"];
 set_gate -> set_review [lf_on="false"];
 set_ask -> waiting [lf_on="published"];
 set_review -> waiting [lf_on="published"];
 story_loop [lf_action="lf_loop", lf_outcomes="true,false", lf_field="response", lf_condition="story", lf_limit="8"];
 story_pick [lf_action="lf_loop", lf_outcomes="true,false", lf_field="response", lf_condition="create", lf_limit="13"];
 story_agent [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="plan-story", lf_skills="plan-story-shaping", lf_limit="13"];
 story_question [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_source="story_agent", lf_limit="13"];
 story_draft [lf_action="lf_plan_story", lf_source="story_agent", lf_outcomes="applied,conflict,failed,uncertain", lf_limit="13"];
 story_gate [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="approved", lf_limit="13"];
 story_ask [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_source="story_agent", lf_limit="8"];
 story_review [lf_action="lf_ask", lf_outcomes="published", lf_kind="review", lf_source="story_agent", lf_limit="13"];
 story_loop -> story_agent [lf_on="true"];
 story_loop -> stopped [lf_on="false"];
 story_agent -> story_question [lf_on="success"];
 story_agent -> failed [lf_on="failed"];
 story_question -> story_ask [lf_on="true"];
 story_question -> story_draft [lf_on="false"];
 story_draft -> story_gate [lf_on="applied"];
 story_draft -> failed [lf_on="conflict"];
 story_draft -> failed [lf_on="failed"];
 story_draft -> failed [lf_on="uncertain"];
 story_gate -> promoted [lf_on="true"];
 story_gate -> story_review [lf_on="false"];
 story_ask -> waiting [lf_on="published"];
 story_review -> story_pick [lf_on="published"];
 story_pick -> story_agent [lf_on="true"];
 story_pick -> waiting [lf_on="false"];
 technical_loop [lf_action="lf_loop", lf_outcomes="true,false", lf_field="response", lf_condition="technical", lf_limit="8"];
 technical_agent [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="plan-technical", lf_skills="plan-technical-shaping", lf_limit="8"];
 technical_question [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_source="technical_agent", lf_limit="8"];
 technical_draft [lf_action="lf_plan_story", lf_source="technical_agent", lf_outcomes="applied,conflict,failed,uncertain", lf_limit="8"];
 technical_gate [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="approved", lf_limit="8"];
 technical_ask [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_source="technical_agent", lf_limit="8"];
 technical_review [lf_action="lf_ask", lf_outcomes="published", lf_kind="review", lf_source="technical_agent", lf_limit="8"];
 technical_loop -> technical_agent [lf_on="true"];
 technical_loop -> stopped [lf_on="false"];
 technical_agent -> technical_question [lf_on="success"];
 technical_agent -> failed [lf_on="failed"];
 technical_question -> technical_ask [lf_on="true"];
 technical_question -> technical_draft [lf_on="false"];
 technical_draft -> technical_gate [lf_on="applied"];
 technical_draft -> failed [lf_on="conflict"];
 technical_draft -> failed [lf_on="failed"];
 technical_draft -> failed [lf_on="uncertain"];
 technical_gate -> promoted [lf_on="true"];
 technical_gate -> technical_review [lf_on="false"];
 technical_ask -> waiting [lf_on="published"];
 technical_review -> waiting [lf_on="published"];
 acceptance_loop [lf_action="lf_loop", lf_outcomes="true,false", lf_field="response", lf_condition="acceptance", lf_limit="8"];
 acceptance_agent [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="plan-acceptance", lf_skills="plan-acceptance-shaping", lf_limit="8"];
 acceptance_question [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="ask", lf_source="acceptance_agent", lf_limit="8"];
 acceptance_draft [lf_action="lf_plan_story", lf_source="acceptance_agent", lf_outcomes="applied,conflict,failed,uncertain", lf_limit="8"];
 acceptance_gate [lf_action="lf_if", lf_outcomes="true,false", lf_field="response", lf_condition="approved", lf_limit="8"];
 acceptance_ask [lf_action="lf_ask", lf_outcomes="published", lf_kind="question", lf_source="acceptance_agent", lf_limit="8"];
 acceptance_review [lf_action="lf_ask", lf_outcomes="published", lf_kind="review", lf_source="acceptance_agent", lf_limit="8"];
 acceptance_loop -> acceptance_agent [lf_on="true"];
 acceptance_loop -> stopped [lf_on="false"];
 acceptance_agent -> acceptance_question [lf_on="success"];
 acceptance_agent -> failed [lf_on="failed"];
 acceptance_question -> acceptance_ask [lf_on="true"];
 acceptance_question -> acceptance_draft [lf_on="false"];
 acceptance_draft -> acceptance_gate [lf_on="applied"];
 acceptance_draft -> failed [lf_on="conflict"];
 acceptance_draft -> failed [lf_on="failed"];
 acceptance_draft -> failed [lf_on="uncertain"];
 acceptance_gate -> promoted [lf_on="true"];
 acceptance_gate -> acceptance_review [lf_on="false"];
 acceptance_ask -> waiting [lf_on="published"];
 acceptance_review -> waiting [lf_on="published"];
 failed [lf_action="lf_comment", lf_outcomes="published", lf_kind="failure", lf_limit="1"];
 failed -> stopped [lf_on="published"];
 waiting [lf_terminal="true"];
 promoted [lf_terminal="true"];
 stopped [lf_terminal="true"];
}
