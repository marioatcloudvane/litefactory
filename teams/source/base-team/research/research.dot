// Research is one agent. It investigates the owner's request, shapes a scope it
// would defend, writes RESEARCH_BRIEF.md in its session directory and reports.
// All of that lives in the role's Markdown. The factory only posts and waits.
//
// The agent's result names its own response (lf_response="result"): "ask",
// "done" or "failed". A question is posted and the instance waits for the
// owner, whose reply resumes this same agent with its saved result as context.
// A finished result posts the agent's final report. There is no approval step:
// `/plan` is the owner's real gate, and a later comment starts the next Research
// from this one. A failed attempt posts why and stops.
digraph research {
 graph [team="{{team}}", mode="research", profile_version="2", start="research"];

 research [lf_action="lf_agent", lf_agent_markdown="research", lf_skills="research-evidence,research-mode-feature,research-mode-change,research-mode-bug,research-mode-refactor,research-mode-integration,research-mode-operations,research-mode-agent-guidance", lf_response="result", lf_outcomes="ask,done,failed", lf_limit="8"];
 ask      [lf_action="lf_ask", lf_kind="question", lf_outcomes="published", lf_source="research", lf_limit="8"];
 report   [lf_action="lf_comment", lf_kind="final", lf_outcomes="published", lf_source="research", lf_limit="8"];
 failed   [lf_action="lf_comment", lf_kind="failure", lf_outcomes="published", lf_limit="8"];
 waiting  [lf_terminal="true"];
 complete [lf_terminal="true"];
 stopped  [lf_terminal="true"];

 research -> ask    [lf_on="ask"];
 research -> report [lf_on="done"];
 research -> failed [lf_on="failed"];
 ask      -> waiting  [lf_on="published"];
 report   -> complete [lf_on="published"];
 failed   -> stopped  [lf_on="published"];
}
