// Implement runs a managed feature as a graph. The factory decides which path a
// run takes: the parent issue takes the coordinator path, and each story
// sub-issue takes the worker path with a session, branch and worktree of its
// own. Independent stories therefore build side by side, and a story that fails
// does not stop the others.
//
// Coordinator (parent issue). It first brings the repository's base branch
// (main) into the feature branch, so stories build on a current base. An owner
// reply that resumes parked stories enters at this base sync again, so a fix
// that reached main while the stories waited reaches them too. Then it
// merges finished stories until none is left and starts every story that is
// ready. While stories build it rests at await
// and ends the run; it wakes when a story changes state. When no story can start
// or finish, it writes the hand-off report. If any story is parked, it asks the
// owner one question that lists them all and waits. If every story is merged,
// it brings main in once more and reports completion on the parent once. When
// main conflicts with the feature branch, a resolver agent merges it in the
// parent's worktree and resolves the conflict; the factory saves a completed
// answer and syncs again. Only a blocked resolver asks the owner. The
// coordinator itself never writes code.
//
// Worker (story sub-issue). The repair budget is counted in the story ledger:
// the first attempt and two repairs. Each permitted entry first synchronizes
// the selected story base; conflicts or exhausted sync retries park the story.
// One write-access agent writes the code and
// its tailored unit tests and runs them. Only an accepted completed answer is
// saved (committed and pushed), and only then is the story done. A blocked
// answer parks the story at once with the agent's own reason. An incomplete
// answer, a failed attempt or a failed save counts one attempt and goes back to
// the budget decision; the next attempt receives the reason. An exhausted budget
// parks the story with the last worker's own reason.
//
// This file is the only place the flow lives. Go supplies steps and never picks
// the next step. Every node has a positive lf_limit; the limits on the coordinator
// loop are sized for the largest story set plus owner resumes, and the worker
// limits hold the three attempts plus the final park.
digraph implement {
 graph [team="{{team}}", mode="implement", profile_version="1", start="select_path"];

 // ---- Path selection ---------------------------------------------------------
 select_path [lf_action="lf_implement_select", lf_outcomes="coordinator,worker", lf_limit="4"];

 // ---- Coordinator --------------------------------------------------------------
 merge      [lf_action="lf_implement_merge", lf_outcomes="merged,parked,none,retry", lf_limit="64"];
 ready      [lf_action="lf_implement_ready", lf_outcomes="started,waiting,drained", lf_limit="64"];
 await      [lf_action="lf_implement_await", lf_outcomes="go", lf_limit="64"];
 handoff    [lf_action="lf_implement_handoff", lf_outcomes="posted", lf_limit="16"];
 any_parked [lf_action="lf_implement_any_parked", lf_outcomes="true,false", lf_limit="16"];
 ask_owner  [lf_action="lf_implement_ask", lf_outcomes="published", lf_source="sync_start", lf_limit="16"];
 report_done [lf_action="lf_implement_report_done", lf_outcomes="published", lf_source="merge", lf_limit="16"];

 // ---- Base sync ------------------------------------------------------------------
 sync_start          [lf_action="lf_sync_base", lf_outcomes="synced,current,conflict,retry,deferred", lf_limit="32"];
 sync_start_resolve  [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="sync-resolver", lf_skills="implement-result,litefactory-rules", lf_limit="3"];
 sync_start_resolved [lf_action="lf_implement_resolved", lf_outcomes="resolved,blocked,retry", lf_source="sync_start_resolve", lf_limit="3"];
 sync_done           [lf_action="lf_sync_base", lf_outcomes="synced,current,conflict,retry", lf_limit="8"];
 sync_done_resolve   [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="sync-resolver", lf_skills="implement-result,litefactory-rules", lf_limit="3"];
 sync_done_resolved  [lf_action="lf_implement_resolved", lf_outcomes="resolved,blocked,retry", lf_source="sync_done_resolve", lf_limit="3"];

 // ---- Worker -----------------------------------------------------------------------
 sync_before_worker [lf_action="lf_sync_base", lf_outcomes="synced,current,conflict,retry,deferred", lf_limit="8"];
 budget        [lf_action="lf_implement_budget", lf_outcomes="run,park", lf_limit="8"];
 worker_agent  [lf_slot_budget="3", lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="story-worker", lf_standards="story-worker", lf_skills="implement-result,litefactory-rules", lf_budget="120", lf_limit="3"];
 worker_result [lf_action="lf_implement_result", lf_outcomes="completed,incomplete,blocked", lf_source="worker_agent", lf_limit="3"];
 story_done    [lf_action="lf_implement_story_done", lf_outcomes="done,retry", lf_limit="3"];
 park_story    [lf_action="lf_implement_park", lf_outcomes="parked", lf_limit="4"];

 // ---- Terminals ------------------------------------------------------------------------
 waiting       [lf_terminal="true"];
 finished      [lf_terminal="true"];
 worker_done   [lf_terminal="true"];
 worker_parked [lf_terminal="true"];

 select_path -> sync_start [lf_on="coordinator"];
 select_path -> budget     [lf_on="worker"];

 // Coordinator start: bring main into the feature branch before any story
 // starts. A conflict goes to the resolver; a completed resolution is saved and
 // the sync runs again. A busy or moved branch rests at await and goes on.
 sync_start          -> merge               [lf_on="synced"];
 sync_start          -> merge               [lf_on="current"];
 sync_start          -> merge               [lf_on="deferred"];
 sync_start          -> sync_start_resolve  [lf_on="conflict"];
 sync_start          -> await               [lf_on="retry"];
 sync_start_resolve  -> sync_start_resolved [lf_on="success"];
 sync_start_resolve  -> sync_start          [lf_on="failed"];
 sync_start_resolved -> sync_start          [lf_on="resolved"];
 sync_start_resolved -> sync_start          [lf_on="retry"];
 sync_start_resolved -> waiting             [lf_on="blocked"];

 // Coordinator: merge until none, then ready. A started or waiting result rests
 // at await; a drained one is the end of the work.
 merge -> merge   [lf_on="merged"];
 merge -> merge   [lf_on="parked"];
 merge -> ready   [lf_on="none"];
 merge -> await   [lf_on="retry"];
 ready -> await   [lf_on="started"];
 ready -> await   [lf_on="waiting"];
 ready -> handoff [lf_on="drained"];
 await -> merge   [lf_on="go"];

 // After the hand-off, one question for every parked story, or main once more
 // and the completion reply and finish.
 handoff     -> any_parked  [lf_on="posted"];
 any_parked  -> ask_owner   [lf_on="true"];
 any_parked  -> sync_done   [lf_on="false"];
 ask_owner   -> waiting     [lf_on="published"];
 report_done -> finished    [lf_on="published"];

 // Coordinator end: bring main in again before the completion reply.
 sync_done          -> report_done        [lf_on="synced"];
 sync_done          -> report_done        [lf_on="current"];
 sync_done          -> sync_done_resolve  [lf_on="conflict"];
 sync_done          -> sync_done          [lf_on="retry"];
 sync_done_resolve  -> sync_done_resolved [lf_on="success"];
 sync_done_resolve  -> sync_done          [lf_on="failed"];
 sync_done_resolved -> sync_done          [lf_on="resolved"];
 sync_done_resolved -> sync_done          [lf_on="retry"];
 sync_done_resolved -> waiting            [lf_on="blocked"];

 // Worker: budget, then synchronize the selected story base before the agent. Completed is saved; blocked parks at once. An
 // incomplete answer, a failed attempt or a failed save goes back to the budget.
 budget        -> sync_before_worker [lf_on="run"];
 sync_before_worker -> worker_agent [lf_on="synced"];
 sync_before_worker -> worker_agent [lf_on="current"];
 sync_before_worker -> worker_agent [lf_on="deferred"];
 sync_before_worker -> sync_before_worker [lf_on="retry"];
 sync_before_worker -> park_story [lf_on="conflict"];
 budget        -> park_story    [lf_on="park"];
 worker_agent  -> worker_result [lf_on="success"];
 worker_agent  -> budget        [lf_on="failed"];
 worker_result -> story_done    [lf_on="completed"];
 worker_result -> budget        [lf_on="incomplete"];
 worker_result -> park_story    [lf_on="blocked"];
 story_done    -> worker_done   [lf_on="done"];
 story_done    -> budget        [lf_on="retry"];
 park_story    -> worker_parked [lf_on="parked"];
}
