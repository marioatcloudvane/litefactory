// Implement runs a managed feature as a graph. The factory decides which path a
// run takes: the parent issue takes the coordinator path, and each story
// sub-issue takes the worker path with a session, branch and worktree of its
// own. Independent stories therefore build side by side, and a story that fails
// does not stop the others.
//
// Coordinator (parent issue). It merges finished stories until none is left,
// then starts every story that is ready. While stories build it rests at await
// and ends the run; it wakes when a story changes state. When no story can start
// or finish, it writes the hand-off report. If any story is parked, it asks the
// owner one question that lists them all and waits. The coordinator never
// writes code.
//
// Worker (story sub-issue). The repair budget is counted in the story ledger:
// the first attempt and two repairs. One write-access agent writes the code and
// its tailored unit tests and runs them. Only an accepted completed answer is
// saved (committed and pushed), and only then is the story done. A blocked or
// incomplete answer parks the story at once with the agent's own reason. A failed
// attempt, a failed save or an exhausted budget go to the budget decision.
//
// This file is the only place the flow lives. Go supplies steps and never picks
// the next step. Every node has a positive lf_limit; the limits on the coordinator
// loop are sized for the largest story set plus owner resumes.
digraph implement {
 graph [team="dotnet-web", mode="implement", profile_version="1", start="select_path"];

 // ---- Path selection ---------------------------------------------------------
 select_path [lf_action="lf_implement_select", lf_outcomes="coordinator,worker", lf_limit="4"];

 // ---- Coordinator --------------------------------------------------------------
 merge      [lf_action="lf_implement_merge", lf_outcomes="merged,parked,none,retry", lf_limit="64"];
 ready      [lf_action="lf_implement_ready", lf_outcomes="started,waiting,drained", lf_limit="64"];
 await      [lf_action="lf_implement_await", lf_outcomes="go", lf_limit="64"];
 handoff    [lf_action="lf_implement_handoff", lf_outcomes="posted", lf_limit="16"];
 any_parked [lf_action="lf_implement_any_parked", lf_outcomes="true,false", lf_limit="16"];
 ask_owner  [lf_action="lf_implement_ask", lf_outcomes="published", lf_source="merge", lf_limit="16"];

 // ---- Worker -----------------------------------------------------------------------
 budget        [lf_action="lf_implement_budget", lf_outcomes="run,park", lf_limit="8"];
 worker_agent  [lf_action="lf_agent", lf_outcomes="success,failed", lf_agent_markdown="story-worker", lf_skills="implement-result,team-guidance", lf_limit="3"];
 worker_result [lf_action="lf_implement_result", lf_outcomes="completed,stopped", lf_source="worker_agent", lf_limit="3"];
 story_done    [lf_action="lf_implement_story_done", lf_outcomes="done,retry", lf_limit="3"];
 park_story    [lf_action="lf_implement_park", lf_outcomes="parked", lf_limit="4"];

 // ---- Terminals ------------------------------------------------------------------------
 waiting       [lf_terminal="true"];
 finished      [lf_terminal="true"];
 worker_done   [lf_terminal="true"];
 worker_parked [lf_terminal="true"];

 select_path -> merge  [lf_on="coordinator"];
 select_path -> budget [lf_on="worker"];

 // Coordinator: merge until none, then ready. A started or waiting result rests
 // at await; a drained one is the end of the work.
 merge -> merge   [lf_on="merged"];
 merge -> merge   [lf_on="parked"];
 merge -> ready   [lf_on="none"];
 merge -> await   [lf_on="retry"];
 ready -> await   [lf_on="started"];
 ready -> await   [lf_on="waiting"];
 ready -> handoff [lf_on="drained"];
 await -> merge   [lf_on="go"];

 // After the hand-off, one question for every parked story, or finish.
 handoff    -> any_parked [lf_on="posted"];
 any_parked -> ask_owner  [lf_on="true"];
 any_parked -> finished   [lf_on="false"];
 ask_owner  -> waiting    [lf_on="published"];

 // Worker: budget, then the agent. Completed is saved; blocked or incomplete parks
 // at once. A failed attempt or a failed save goes back to the budget.
 budget        -> worker_agent  [lf_on="run"];
 budget        -> park_story    [lf_on="park"];
 worker_agent  -> worker_result [lf_on="success"];
 worker_agent  -> budget        [lf_on="failed"];
 worker_result -> story_done    [lf_on="completed"];
 worker_result -> park_story    [lf_on="stopped"];
 story_done    -> worker_done   [lf_on="done"];
 story_done    -> budget        [lf_on="retry"];
 park_story    -> worker_parked [lf_on="parked"];
}
